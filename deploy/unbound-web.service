[Unit]
Description=Unbound DNS management panel
Documentation=file:/usr/local/share/doc/unbound-web/README.md
After=network-online.target rsyslog.service
Wants=network-online.target

[Service]
Type=simple
User=unbound-web
Group=unbound-web

EnvironmentFile=/etc/unbound-web/unbound-web.env
ExecStart=/usr/local/bin/unbound-web

Restart=on-failure
RestartSec=5

# The panel listens on the loopback address and a reverse proxy terminates TLS,
# so it needs no capability to bind a privileged port.
CapabilityBoundingSet=
AmbientCapabilities=

# The setuid helper is how the panel reaches PAM, and two sudoers rules are how
# it restarts rsyslog. Both need a privilege the process does not hold, so the
# usual no-new-privileges hardening cannot be turned on here.
NoNewPrivileges=no
RestrictSUIDSGID=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The database, the SSH keys and the one rsyslog file the panel owns. Nothing
# else on the system is writable.
ReadWritePaths=/var/lib/unbound-web
ReadWritePaths=/etc/rsyslog.d/60-unbound-dns-panel.conf

# The panel writes its own log through syslog and its audit trail into the
# database, so stdout carries the startup diagnostics alone.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
