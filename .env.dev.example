# Development environment variables for the local Docker stack.
# Copy this file to .env.dev and replace every CHANGEME value.
# .env.dev is gitignored. Never commit it.

# ---------------------------------------------------------------------------
# Panel test account passwords
# These accounts exist only inside the dev container. They are created by
# docker/testusers.sh and cover every branch of the account policy.
# ---------------------------------------------------------------------------
DEV_PASSWORD_ROOT=CHANGEME_root
DEV_PASSWORD_DNSADMIN=CHANGEME_dnsadmin
DEV_PASSWORD_DNSUSER=CHANGEME_dnsuser
DEV_PASSWORD_SVCACCT=CHANGEME_svcacct
DEV_PASSWORD_LOWUID=CHANGEME_lowuid
DEV_PASSWORD_LOCKEDUSER=CHANGEME_lockeduser
DEV_PASSWORD_EXPIREDUSER=CHANGEME_expireduser
# nopwuser has no password on purpose. It verifies that the panel rejects an
# empty password before it reaches PAM, despite the nullok option in
# Debian common-auth.

# ---------------------------------------------------------------------------
# Panel configuration
# ---------------------------------------------------------------------------
LISTEN_ADDR=0.0.0.0:8080
DATA_DIR=/var/lib/unbound-web
AUTH_HELPER_PATH=/usr/local/libexec/unbound-web-authhelper
PAM_SERVICE=unbound-web
ADMIN_GROUP=sudo
ALLOWED_GROUP=
MIN_UID=1000
AUTH_MAX_CONCURRENT=4
# TLS terminates at a reverse proxy in production. The dev stack serves plain
# HTTP on localhost, so the Secure cookie flag is off here only.
COOKIE_SECURE=false
DIG_PATH=dig

# The timeouts, the intervals and the limits live in the settings table and are
# changed on the settings page. Only what is read once at startup, or what
# decides a privilege, stays here.

# ---------------------------------------------------------------------------
# Panel rsyslog commands
# The container has no systemd, so these override the production defaults.
# ---------------------------------------------------------------------------
RSYSLOG_RESTART_CMD=sudo /usr/local/bin/rsyslog-restart
RSYSLOG_STATUS_CMD=pgrep -x rsyslogd
RSYSLOG_VALIDATE_CMD=sudo /usr/sbin/rsyslogd -N1
RSYSLOG_CONF_PATH=/etc/rsyslog.d/60-unbound-dns-panel.conf
SYSLOG_LOG_PATH=/var/log/unbound-dns-panel.log

# ---------------------------------------------------------------------------
# Dev stack fixtures
# ---------------------------------------------------------------------------
# Seeds the four server records and the resolvers group on first start.
DEV_SEED_SERVERS=true
# Adds a deliberate echo to the dnsops .bashrc on a target when set to 1.
# Leave it at 0. The integration test enables it only for the pollution check,
# because a permanently polluted target would break every other test.
SHELL_POLLUTION=0
