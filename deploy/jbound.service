[Unit]
Description=JBound Unbound DNS management panel
Documentation=file:/usr/local/share/doc/jbound/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jbound
Group=jbound

EnvironmentFile=/etc/jbound/jbound.env
ExecStart=/usr/local/bin/jbound

Restart=on-failure
RestartSec=5

# The panel listens on the loopback address and a reverse proxy terminates TLS,
# so it needs no capability to bind a privileged port.
CapabilityBoundingSet=
AmbientCapabilities=

# The setuid helper is how the panel reaches PAM, and it needs a privilege the
# process does not hold. That is the one remaining reason the usual
# no-new-privileges hardening cannot be turned on here.
NoNewPrivileges=no
RestrictSUIDSGID=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The database and the SSH keys. Nothing else on the system is writable, and
# the panel needs nothing else: it sends its trail to the receiver over a
# socket rather than through a file anything else reads.
ReadWritePaths=/var/lib/jbound

# The panel keeps its audit trail in the database and sends it from there, so
# stdout carries the operational log alone.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
