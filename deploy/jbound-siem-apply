#!/bin/sh
# Renders the panel's rsyslog configuration from the rules the panel wrote.
#
# rsyslog runs as root and its configuration can name a program to execute, so
# write access to the file below is write access to the machine. The panel does
# not have it. The panel writes forwarding rules into a file inside its own
# data directory, and this script is the only thing that turns them into
# configuration.
#
# It runs as root through one sudoers rule. It takes no argument, reads no path
# from its caller and accepts no rule the pattern below refuses, so what the
# panel can put in front of rsyslog is exactly what that pattern allows.
#
# Restarting the daemon is a separate step and a separate sudoers rule. It needs
# no protection: by the time it runs, the file it reloads is one this script
# wrote.
#
# Exit codes:
#   0  the configuration is in place
#   2  the rules were refused, and the previous configuration is still in place
#   1  anything else

set -eu

# Both paths are fixed here rather than taken from the caller, which is the
# whole point of this script. DATA_DIR or SYSLOG_LOG_PATH changed in
# /etc/jbound/jbound.env must be changed here to match.
RULES=/var/lib/jbound/siem-rules.conf
CONF=/etc/rsyslog.d/60-jbound.conf
LOG=/var/log/jbound.log

# The group that reads the panel log. The panel is one of its members, which is
# how it reads its own log back without joining a group like adm that carries
# every other service's records too.
LOG_GROUP=jbound

# One forwarding rule and nothing else. A whitelist rather than a blacklist,
# because this file is read by a daemon running as root and listing the
# constructs that are dangerous is a game the writer of the list loses.
PATTERN='^local6\.[A-Za-z*]+[[:space:]]+@{1,2}[A-Za-z0-9._-]+(:[0-9]{1,5})?$'

if [ "$(id -u)" -ne 0 ]; then
    echo "error: run this script as root" >&2
    exit 1
fi

# --- Read the rules the panel wrote ------------------------------------------
# A panel that has never forwarded anything has no file yet, and that is the
# same configuration as one with no rules in it.
if [ -e "$RULES" ]; then
    number=0
    while IFS= read -r line || [ -n "$line" ]; do
        number=$((number + 1))
        trimmed=$(printf '%s' "$line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$trimmed" in
            '' | '#'*) continue ;;
        esac
        if ! printf '%s\n' "$trimmed" | grep -Eq "$PATTERN"; then
            echo "line $number is not a forwarding rule: $trimmed" >&2
            exit 2
        fi
    done < "$RULES"
fi

# --- Render ------------------------------------------------------------------
TMP=$(mktemp)
BACKUP=$(mktemp)
trap 'rm -f "$TMP" "$BACKUP"' EXIT

{
    cat <<'HEADER'
# JBound - Syslog Configuration
# Logs from the DNS management panel (facility local6)
#
# This file is generated by jbound-siem-apply from the rules the panel wrote.
# Edit it through the SIEM page. Anything written here by hand is lost on the
# next save.

# Template: SIEM-compatible format with ISO8601 timestamp
template(name="JBoundPanelFormat" type="string"
    string="%timegenerated:::date-rfc3339% %HOSTNAME% %syslogtag%%msg%\n"
)

HEADER

    # The ownership is set on the action rather than through the legacy
    # $FileGroup directive, which would apply to every file rsyslog creates
    # after this one and take the syslog of the whole host with it.
    cat <<ACTION
# Write to dedicated log file
local6.*    action(type="omfile" file="$LOG" template="JBoundPanelFormat"
    fileOwner="root" fileGroup="$LOG_GROUP" fileCreateMode="0640")

# --- SIEM forwarding ---------------------------------------------------------
ACTION

    if [ -e "$RULES" ]; then
        cat "$RULES"
    fi

    cat <<'FOOTER'
# -----------------------------------------------------------------------------

# Stop processing these messages in other log files
& stop
FOOTER
} > "$TMP"

# --- Install, and put the old one back when rsyslog will not have it ---------
HAD_CONF=no
if [ -e "$CONF" ]; then
    HAD_CONF=yes
    cp -p "$CONF" "$BACKUP"
fi

install -m 0644 -o root -g root "$TMP" "$CONF"

if ! output=$(rsyslogd -N1 2>&1); then
    # A configuration the daemon will not load would leave the panel with no
    # log at all after the next restart, which surfaces hours later and far
    # from its cause.
    if [ "$HAD_CONF" = yes ]; then
        cp -p "$BACKUP" "$CONF"
    else
        rm -f "$CONF"
    fi
    printf '%s\n' "$output" >&2
    exit 2
fi

echo "wrote $CONF"
