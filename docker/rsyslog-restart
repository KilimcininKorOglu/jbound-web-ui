#!/bin/sh
# Stands in for "systemctl restart rsyslog" inside the development container.
#
# The panel calls this through sudo, exactly as it calls systemctl in
# production. The exit code is what the panel checks, so failures must not be
# swallowed.

set -eu

PIDFILE=/run/rsyslogd.pid

if [ -f "$PIDFILE" ]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null || true
    # Give rsyslogd a moment to release its sockets before restarting.
    i=0
    while [ -f "$PIDFILE" ] && [ "$i" -lt 20 ]; do
        sleep 0.1
        i=$((i + 1))
    done
fi

/usr/sbin/rsyslogd -i "$PIDFILE"
