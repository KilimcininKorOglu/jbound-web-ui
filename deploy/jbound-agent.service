[Unit]
Description=JBound agent for the local Unbound resolver
Documentation=file:/usr/local/share/doc/jbound/README.md
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=simple

# Its own account, created by setup-agent.sh, which also grants it the three
# things the steps need: read on the control credentials, write in the
# resolver's configuration directory, and one polkit rule for the restart. No
# sudoers rule anywhere, which is the surface this binary exists to remove.
#
# A host with no polkit cannot grant the restart to anybody but root, and
# setup-agent.sh writes a drop-in here that says so rather than leaving an
# agent that cannot restart the resolver it just reconfigured.
User=jbound-agent
Group=jbound-agent

EnvironmentFile=/etc/jbound-agent/jbound-agent.env
ExecStart=/usr/local/bin/jbound-agent

Restart=on-failure
RestartSec=5

# Nothing it runs needs a privilege it does not already hold, unlike the panel,
# so this can be on.
NoNewPrivileges=yes

# Binding 8443 needs no capability, and neither does anything else here.
CapabilityBoundingSet=
AmbientCapabilities=

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The resolver configuration directory and nothing else. The agent writes two
# files in it: the records file and the main configuration it has to include
# that file from.
ReadWritePaths=/etc/unbound

# The agent writes its own diagnostics. The audit trail lives in the panel.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
