[Unit]
Description=JBound Unbound DNS management panel
Documentation=file:/usr/local/share/doc/jbound/README.md
After=network-online.target rsyslog.service
Wants=network-online.target

[Service]
Type=simple
User=jbound
Group=jbound

EnvironmentFile=/etc/jbound/jbound.env
ExecStart=/usr/local/bin/jbound

Restart=on-failure
RestartSec=5

# The panel listens on the loopback address and a reverse proxy terminates TLS,
# so it needs no capability to bind a privileged port.
CapabilityBoundingSet=
AmbientCapabilities=

# The setuid helper is how the panel reaches PAM, and two sudoers rules are how
# it applies its forwarding rules and restarts rsyslog. Both need a privilege
# the process does not hold, so the usual no-new-privileges hardening cannot be
# turned on here.
NoNewPrivileges=no
RestrictSUIDSGID=no

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# The database, the SSH keys and the forwarding rules. Nothing else on the
# system is writable, and that includes the rsyslog configuration: the panel
# writes rules and jbound-siem-apply is what turns them into configuration.
ReadWritePaths=/var/lib/jbound

# The panel writes its own log through syslog and its audit trail into the
# database, so stdout carries the startup diagnostics alone.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
