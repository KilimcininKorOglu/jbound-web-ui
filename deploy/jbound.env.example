# The environment of the panel service.
#
# Only the values that decide where the panel runs and who may sign in live
# here. Everything an operator tunes while the panel is running (timeouts, page
# sizes, the syslog switch, the interface defaults) lives in the settings page
# and in the database, so this file stays short and rarely changes.
#
# Copy to /etc/jbound/jbound.env and read it back after every change:
# a value with a shell metacharacter is refused at startup.

# Where the panel listens. Keep it on the loopback address and terminate TLS in
# a reverse proxy. A panel open to the internet is not supported.
LISTEN_ADDR=127.0.0.1:8080

# The database and the SSH keys. Both are backed up together.
DATA_DIR=/var/lib/jbound

# The setuid helper. It is the only privileged component and the only path that
# reads the shadow database.
AUTH_HELPER_PATH=/usr/local/libexec/jbound-authhelper

# The PAM service file, installed as /etc/pam.d/jbound.
PAM_SERVICE=jbound

# Who may sign in and who may administer. A member of ADMIN_GROUP manages
# servers, groups, the SIEM configuration and the settings page. Leaving
# ALLOWED_GROUP empty lets every local account with a uid at or above MIN_UID
# sign in as a plain user.
ADMIN_GROUP=sudo
ALLOWED_GROUP=
MIN_UID=1000

# How many sign-ins the helper handles at once. PAM is slow on purpose, and an
# unbounded queue would make that a way to exhaust the host.
AUTH_MAX_CONCURRENT=4

# The session cookie is only sent over HTTPS. Turn this off only where the
# panel is reached over plain HTTP on a trusted network.
COOKIE_SECURE=true

# The resolver used by the query panel.
DIG_PATH=/usr/bin/dig

# How much the panel writes: debug, info, warn or error. Send SIGUSR1 to the
# running process to switch to debug and back without a restart:
#   systemctl kill -s USR1 jbound
LOG_LEVEL=info

# The rsyslog file the panel owns, and the log it reads back. The installer
# creates the file root:jbound 0664 so the panel can write it without
# touching the directory.
RSYSLOG_CONF_PATH=/etc/rsyslog.d/60-jbound.conf
SYSLOG_LOG_PATH=/var/log/jbound.log

# The commands behind the two sudoers rules. They run through exec without a
# shell, so no metacharacter is accepted here.
RSYSLOG_RESTART_CMD=systemctl restart rsyslog
RSYSLOG_STATUS_CMD=systemctl is-active rsyslog
RSYSLOG_VALIDATE_CMD=rsyslogd -N1
