#!/bin/sh
### BEGIN INIT INFO
# Provides:          unbound
# Required-Start:    $network $remote_fs
# Required-Stop:     $network $remote_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: Unbound DNS resolver
### END INIT INFO
#
# Development only. Debian ships Unbound with a systemd unit, and containers
# have no systemd, so "service unbound reload" would fail. The service command
# falls back to /etc/init.d when systemd is absent, so this script keeps the
# panel using the exact same reload command as production.

set -eu

PIDFILE=/run/unbound.pid
CONF=/etc/unbound/unbound.conf

# unbound_pid answers with one pid or nothing.
#
# The pidfile is checked against the process it names rather than believed. A
# container keeps its filesystem when it is stopped and started again, so the
# file outlives the daemon: a start that trusted it would report a resolver
# that is already running while nothing is, status would agree, and every
# query would time out with nothing anywhere saying why.
#
# The fallback matches the command line rather than the process name. This
# script is called unbound, so a name match finds itself and every start then
# reports a daemon that is already running while nothing is.
#
# The first line only. Two processes can exist while a restart is half done,
# and passing both to kill fails with "Illegal number" rather than signalling
# either of them.
unbound_pid() {
    if [ -f "$PIDFILE" ]; then
        pid=$(head -n1 "$PIDFILE")
        if [ -n "$pid" ] && grep -qs '^/usr/sbin/unbound' "/proc/$pid/cmdline"; then
            echo "$pid"
            return 0
        fi
        rm -f "$PIDFILE"
    fi
    pgrep -f "^/usr/sbin/unbound -c" | head -n1 || true
}

case "${1:-}" in
    reload|force-reload)
        pid=$(unbound_pid)
        if [ -z "$pid" ]; then
            echo "unbound is not running" >&2
            exit 1
        fi
        # Unbound rereads its configuration, including local_records.conf, on
        # SIGHUP. This is what the panel triggers after writing records.
        kill -HUP "$pid"
        echo "unbound reloaded"
        ;;
    status)
        pid=$(unbound_pid)
        if [ -z "$pid" ]; then
            echo "unbound is not running"
            exit 3
        fi
        echo "unbound is running (pid $pid)"
        ;;
    start)
        if [ -n "$(unbound_pid)" ]; then
            echo "unbound is already running"
            exit 0
        fi
        /usr/sbin/unbound -c "$CONF"

        # The daemon forks, so it is running by the time this returns. Waiting
        # for the pidfile makes that certain, and a start that reports success
        # while nothing came up would make the panel report the same.
        i=0
        while [ $i -lt 50 ]; do
            [ -n "$(unbound_pid)" ] && { echo "unbound started"; exit 0; }
            sleep 0.1
            i=$((i + 1))
        done
        echo "unbound did not come up" >&2
        exit 1
        ;;
    stop)
        pid=$(unbound_pid)
        if [ -n "$pid" ]; then
            kill "$pid"

            # Wait for it to go. A restart that started the next process while
            # this one was still shutting down would leave two daemons on the
            # same port, and the second would fail to bind.
            i=0
            while [ $i -lt 50 ] && kill -0 "$pid" 2>/dev/null; do
                sleep 0.1
                i=$((i + 1))
            done
        fi
        rm -f "$PIDFILE"
        ;;
    restart)
        "$0" stop || true
        "$0" start
        ;;
    *)
        echo "usage: $0 {start|stop|restart|reload|status}" >&2
        exit 2
        ;;
esac
